# OCI API credentials
OCI_USER=ocid1.user.oc1..xxxxxxxxxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_TENANCY=ocid1.tenancy.oc1..xxxxxxxxxxxx
OCI_REGION=eu-zurich-1
OCI_KEY_FILE=/home/ubuntu/.oci/oci_api_key.pem

# Instance parameters
COMPARTMENT_ID=ocid1.compartment.oc1..xxxxxxxxxxxx
SUBNET_ID=ocid1.subnet.oc1.eu-zurich-1.xxxxxxxxxxxx
IMAGE_ID=  # optional: leave empty to auto-detect latest Ubuntu 22.04 aarch64
# One AD, or several comma-separated (attempts rotate through them, one AD per attempt), e.g.
# AVAILABILITY_DOMAIN=yiDf:EU-FRANKFURT-1-AD-1,yiDf:EU-FRANKFURT-1-AD-2,yiDf:EU-FRANKFURT-1-AD-3
AVAILABILITY_DOMAIN=xxxx:EU-ZURICH-1-AD-1
# Pause between attempts tunes itself: it remembers where OCI last answered
# 429 TooManyRequests and stays just above that. Optional bounds (seconds):
# PAUSE_START_S=60
# PAUSE_MIN_S=15
# PAUSE_MAX_S=300
INSTANCE_NAME=arm-instance
# How many instances to hunt (named arm-instance, arm-instance-2, ...)
TARGET_INSTANCES=1
SHAPE=VM.Standard.A1.Flex
# Always Free A1 limit is 2 OCPU / 12 GB per account (since 2026-06-15)
OCPUS=2
MEMORY_GB=12

# SSH public key (generated on this server)
SSH_PUBLIC_KEY_PATH=/home/ubuntu/.ssh/oracle_arm_key.pub

# Time zone for logs and Telegram (summer/winter time switches by itself)
# TIMEZONE=Europe/Berlin

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Email alerts (optional — only sent on a win; leave EMAIL_ENABLED=false to skip)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_USER=sender@gmail.com          # dedicated sender Gmail
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx       # 16-char Gmail App Password (no spaces)
EMAIL_TO=you@gmail.com               # where the win alert lands

# Peer watchdog (optional): this hunter checks another server every 2 min and
# alerts via Telegram + email if it stops responding (~10 min). Empty = off.
PEER_NAME=micro-frankfurt-1
PEER_HOST=
PEER_PORT=22
